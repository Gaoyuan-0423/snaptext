{
  "name": "snaptext",
  "version": "0.2.1",
  "description": "Screenshot OCR on device with optional online translation. 免费开源的截图识字与在线翻译工具。",
  "main": "src/main/main.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gaoyuan-0423/snaptext"
  },
  "scripts": {
    "start": "electron .",
    "test:ocr": "electron scripts/test-ocr.js",
    "fetch:tessdata": "node scripts/fetch-tessdata.js",
    "icons": "node scripts/gen-icons.js",
    "dist": "electron-builder",
    "test": "node --test tests/*.test.js",
    "dist:mas": "electron-builder --config electron-builder.mas.cjs --publish never",
    "install:electron": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.snaptext.app",
    "productName": "SnapText",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "resources/icons/*",
      "resources/bin/*",
      "resources/probe-zh.png",
      "!**/*.md"
    ],
    "extraResources": [
      {
        "from": "resources/tessdata",
        "to": "tessdata",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "resources/bin/**",
      "resources/probe-zh.png"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
